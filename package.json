{
  "name": "codemark",
  "displayName": "CodeMark",
  "description": "A developer bookmark and notes manager",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codemark.addBookmark",
        "title": "Add Bookmark",
        "category": "CodeMark"
      },
      {
        "command": "codemark.openDashboard",
        "title": "Open Dashboard",
        "category": "CodeMark"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codemark-container",
          "title": "CodeMark",
          "icon": "resources/bookmark.svg"
        }
      ]
    },
    "views": {
      "codemark-container": [
        {
          "id": "codemark.bookmarks",
          "name": "Bookmarks"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}
