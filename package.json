{
  "name": "codemark",
  "displayName": "CodeMark",
  "description": "A developer bookmark and notes manager",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codemark.addBookmark",
        "title": "Add Bookmark",
        "category": "CodeMark",
        "icon": "$(bookmark)"
      },
      {
        "command": "codemark.openDashboard",
        "title": "Open Dashboard",
        "category": "CodeMark",
        "icon": "$(table)"
      },
      {
        "command": "codemark.removeBookmark",
        "title": "Remove Bookmark",
        "category": "CodeMark",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codemark-container",
          "title": "CodeMark",
          "icon": "resources/bookmark.svg"
        }
      ]
    },
    "views": {
      "codemark-container": [
        {
          "id": "codemark.bookmarks",
          "name": "Bookmarks"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "codemark.addBookmark",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "codemark.openDashboard",
          "when": "view == codemark.bookmarks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codemark.removeBookmark",
          "when": "view == codemark.bookmarks && viewItem == bookmarkItem",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codemark.addBookmark",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CodeMark",
      "properties": {
        "codemark.highlightColor": {
          "type": "string",
          "default": "rgba(255, 200, 0, 0.15)",
          "description": "Background color applied to bookmarked lines. Accepts any valid CSS color string."
        },
        "codemark.maxBookmarksPerFile": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum number of bookmarks allowed per file. Set to 0 for unlimited."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}
